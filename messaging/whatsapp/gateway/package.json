{
  "name": "whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "Phantom WhatsApp POC gateway (Baileys + HTTP). Localhost-only by default.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node --enable-source-maps dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "baileys": "7.0.0-rc13",
    "fastify": "^5.12.1",
    "link-preview-js": "^4.0.4",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "link-preview-js": "^4.0.4",
    "find-my-way": "9.7.0",
    "fast-uri": "3.1.5",
    "fast-json-stringify": {
      "fast-uri": "4.1.2"
    }
  }
}
